	"nodes":[
		{"id":"1a2b3c4d5e72dde0","type":"group","x":-3080,"y":3840,"width":4480,"height":592,"color":"1","label":"Persistenzschicht — persistence/"},
		{"id":"1a2b3c4d5e714bbd","type":"group","x":-2400,"y":1922,"width":3840,"height":498,"color":"2","label":"models.py"},
		{"id":"1a2b3c4d5e6ff778","type":"group","x":-840,"y":0,"width":2560,"height":628,"color":"5","label":"services.py"},
		{"id":"1a2b3c4d5e71e668","type":"group","x":2400,"y":2800,"width":2560,"height":410,"color":"3","label":"Wertobjekte & Sessions — models.py"},
		{"id":"1a2b3c4d5e707334","type":"group","x":-40,"y":1408,"width":1920,"height":514,"color":"4","label":"business/"},
		{"id":"1a2b3c4d5e6f5ccd","type":"group","x":800,"y":-940,"width":640,"height":480,"color":"6","label":"bank.py"},
		{"id":"1a2b3c4d5e701667","type":"text","text":"#### `MainKontoService`\n`business/konto.py` — implementiert `KontoService`\n\n- `_repository: Repository`\n\n+ «static» create(repository) → KontoService\n+ find_by_kontonummer(kontonummer) → Bankkonto | None\n+ eroeffne_konto(vorname, nachname, pin) → int\n   *begin → create_bankkonto → save → commit, sonst rollback*\n+ erstelle_kontoauszug(session, start, inklusives_ende) → Kontoauszug\n   *baut Kontoauszug aus Start-/Endkontostand + Transaktionen*","x":0,"y":1468,"width":560,"height":394,"color":"4"},
		{"id":"1a2b3c4d5e703556","type":"text","text":"#### `MainGeldautomatenService`\n`business/geldautomat.py` — implementiert `GeldautomatenService`\n\n- `_repository: Repository`\n\n+ create(location, verfuegbares_bargeld) → int  *(≥ 0 validiert)*\n+ find_by_location(location) → Geldautomat | None\n+ login(geldautomat, geldkarte, pin) → GeldautomatSession\n   *check_pin → Konto laden → Session*\n+ aufladen(session, betrag)  *Automat + Konto, transaktional*\n+ abheben(session, betrag) → Decimal  *Automat + Konto*\n+ ermittle_kontostand(session) → Decimal","x":640,"y":1468,"width":560,"height":394,"color":"4"},
		{"id":"1a2b3c4d5e705445","type":"text","text":"#### `MainOnlineBankingService`\n`business/onlinebanking.py` — implementiert `OnlineBankingService`\n\n- `_repository: Repository`\n\n+ «static» create(repository) → OnlineBankingService\n+ login(kontonummer, kundennummer, pin) → OnlineBankingSession\n   *prüft Konto-Existenz, Kundenzuordnung, Online-PIN*\n+ ermittle_kontostand(session) → Decimal\n+ ueberweisen(session, kontonummer_empfaenger, betrag)\n   *abheben + aufladen in einer Transaktion*","x":1280,"y":1468,"width":560,"height":368,"color":"4"},
		{"id":"1a2b3c4d5e6f3dde","type":"text","text":"#### `main()`\n`bank.py` — Einstiegspunkt & Composition Root\n\n**Verdrahtung (DI):**\n`create_engine(\"sqlite:///banking.db\")`\n→ `SqlSession` → `MainRepository`\n→ `MainGeldautomatenService(repo)`\n→ `MainKontoService(repo)`\n→ `MainOnlineBankingService.create(repo)`\n\n**Ablauf (Aufgabe I–IX):** Automat erstellen · Konto eröffnen ·\nAutomat per Location finden · Login · aufladen · abheben ·\nKontoauszug · Online-Login · überweisen","x":840,"y":-880,"width":560,"height":360,"color":"6"},
		{"id":"1a2b3c4d5e6fb99a","type":"text","text":"#### «Protocol» `GeldautomatenService`\n`services.py`\n\n+ create(location: Location, verfuegbares_bargeld: Decimal) → int\n+ find_by_location(location: Location) → Geldautomat | None\n+ login(geldautomat: Geldautomat, geldkarte: Geldkarte, pin: str) → GeldautomatSession\n+ aufladen(session: GeldautomatSession, betrag: Decimal) → None\n+ abheben(session: GeldautomatSession, betrag: Decimal) → Decimal\n+ ermittle_kontostand(session: GeldautomatSession) → Decimal","x":480,"y":60,"width":560,"height":352,"color":"5"},
		{"id":"1a2b3c4d5e6fd889","type":"text","text":"#### «Protocol» `OnlineBankingService`\n`services.py`\n\n+ «static» create(repository: Repository) → OnlineBankingService\n+ login(kontonummer: int, kundennummer: int, pin: str) → OnlineBankingSession\n+ ermittle_kontostand(session: OnlineBankingSession) → Decimal\n+ ueberweisen(session: OnlineBankingSession, kontonummer_empfaenger: int, betrag: Decimal) → None","x":1120,"y":60,"width":560,"height":326,"color":"5"},
		{"id":"1a2b3c4d5e6f7bbc","type":"text","text":"#### «Protocol» `Repository`\n`services.py`\n\n+ find_bankkonto_by_kontonummer(kontonummer: int) → Bankkonto | None\n+ find_geldautomat_by_nummer(nummer: int) → Geldautomat | None\n+ find_geldautomat_by_location(location: Location) → Geldautomat | None\n+ save(obj: object) → None\n+ begin_transaction() → None\n+ commit_transaction() → None\n+ rollback_transaction() → None\n+ create_geldautomat(location, verfuegbares_bargeld: Decimal) → Geldautomat\n+ create_bankkonto(vorname: str, nachname: str, pin: str) → Bankkonto","x":-800,"y":60,"width":560,"height":508,"color":"5"},
		{"id":"1a2b3c4d5e6f9aab","type":"text","text":"#### «Protocol» `KontoService`\n`services.py`\n\n+ «static» create(repository: Repository) → KontoService\n+ find_by_kontonummer(kontonummer: int) → Bankkonto | None\n+ eroeffne_konto(vorname: str, nachname: str, pin: str) → int\n+ erstelle_kontoauszug(session: Session, start: date, inklusives_ende: date) → Kontoauszug","x":-160,"y":60,"width":560,"height":300,"color":"5"},
		{"id":"1a2b3c4d5e70eef0","type":"text","text":"#### «Protocol» `Geldautomat`\n`models.py`\n\n+ nummer: int\n+ location: Location\n+ ermittle_verfuegbares_bargeld() → Decimal\n+ aufladen(betrag: Decimal) → None\n+ abheben(betrag: Decimal) → None","x":-440,"y":1982,"width":560,"height":300,"color":"2"},
		{"id":"1a2b3c4d5e710ddf","type":"text","text":"#### «Protocol» `Transaktion`\n`models.py`\n\n+ zeitpunkt: datetime\n+ betrag: Decimal\n\n*Vorzeichen kodiert die Richtung: Einzahlung `+`, Abhebung `−`*","x":200,"y":1982,"width":560,"height":264,"color":"2"},
		{"id":"1a2b3c4d5e712cce","type":"text","text":"#### «Protocol» `Session`\n`models.py`\n\n+ bankkonto: Bankkonto\n\n*gemeinsamer Nenner beider Session-Arten — `KontoService.erstelle_kontoauszug` arbeitet nur gegen dieses Minimal-Interface*","x":840,"y":1982,"width":560,"height":264,"color":"2"},
		{"id":"1a2b3c4d5e70b112","type":"text","text":"#### «Protocol» `Geldkarte`\n`models.py`\n\n+ kartennummer: int\n+ kontonummer: int\n+ check_pin(pin: str) → bool","x":-1720,"y":1982,"width":560,"height":248,"color":"2"},
		{"id":"1a2b3c4d5e70d001","type":"text","text":"#### «Protocol» `Bankkonto`\n`models.py`\n\n+ kontonummer: int\n+ kunde: Kunde\n+ check_online_banking_pin(pin: str) → bool\n+ ermittle_kontostand(bis: date | None = None) → Decimal\n+ ermittle_transaktionen(inklusives_ende: date) → list[Transaktion]\n+ abheben(betrag: Decimal) → None\n+ aufladen(betrag: Decimal) → None","x":-1080,"y":1982,"width":560,"height":378,"color":"2"},
		{"id":"1a2b3c4d5e709223","type":"text","text":"#### «Protocol» `Kunde`\n`models.py`\n\n+ vorname: str\n+ nachname: str\n+ kundennummer: int\n+ geldkarte: Geldkarte","x":-2360,"y":1982,"width":560,"height":274,"color":"2"},
		{"id":"1a2b3c4d5e71c779","type":"text","text":"#### `OnlineBankingSession`  «frozen dataclass»\n`models.py`\n\n+ bankkonto: Bankkonto\n\n*erfüllt `Session`*","x":4360,"y":2860,"width":560,"height":238,"color":"3"},
		{"id":"1a2b3c4d5e71a88a","type":"text","text":"#### `GeldautomatSession`  «frozen dataclass»\n`models.py`\n\n+ geldautomat: Geldautomat\n+ bankkonto: Bankkonto\n\n*erfüllt `Session`*","x":3720,"y":2860,"width":560,"height":264,"color":"3"},
		{"id":"1a2b3c4d5e716aac","type":"text","text":"#### `Location`  «frozen dataclass»\n`models.py`\n\n+ latitude: float\n+ longitude: float\n\n*Value Object — in der DB als `composite()` auf zwei Spalten abgebildet*","x":2440,"y":2860,"width":560,"height":290,"color":"3"},
		{"id":"1a2b3c4d5e71899b","type":"text","text":"#### `Kontoauszug`  «frozen dataclass»\n`models.py`\n\n+ startkontostand: Decimal\n+ endkontostand: Decimal\n+ transaktionen: list[Transaktion]","x":3080,"y":2860,"width":560,"height":248,"color":"3"},
		{"id":"1a2b3c4d5e720557","type":"text","text":"#### `MainRepository`\n`persistence/repositories.py` — implementiert `Repository`\n\n- `_session: sqlalchemy.orm.Session`\n\n+ find_bankkonto_by_kontonummer → `session.get(orm.Bankkonto, …)`\n+ find_geldautomat_by_nummer / _by_location  *(Composite-Vergleich)*\n+ save(obj)  *nur `orm.Geldautomat` | `orm.Bankkonto`, sonst `TypeError`*\n+ begin_/commit_/rollback_transaction()\n+ create_geldautomat(location, bargeld)  *(≥ 0 validiert)*\n+ create_bankkonto(vorname, nachname, pin)\n   *legt Konto + Kunde + Geldkarte an, `flush()` für die Kontonummer*","x":-3040,"y":3900,"width":560,"height":472,"color":"1"},
		{"id":"1a2b3c4d5e722446","type":"text","text":"#### `Base(DeclarativeBase)`\n`persistence/orm.py`\n\n*SQLAlchemy-Basisklasse — `Base.metadata.create_all(engine)` erzeugt das Schema*","x":-2400,"y":3900,"width":560,"height":222,"color":"1"},
		{"id":"1a2b3c4d5e724335","type":"text","text":"#### `orm.Bankkonto` → `bankkonten`\n`persistence/orm.py`\n\n+ kontonummer: int «PK, Identity»\n+ online_pin: str\n+ kunde: Kunde «relationship, 1:1»\n+ transaktionen: list[Transaktion] «1:n»\n\n+ check_online_banking_pin(pin) → bool\n+ ermittle_kontostand(bis=None) → Decimal\n+ ermittle_transaktionen(bis) → list\n+ abheben/aufladen(betrag)  *legt Transaktion an*","x":-1760,"y":3900,"width":560,"height":394,"color":"1"},
		{"id":"1a2b3c4d5e726224","type":"text","text":"#### `orm.Kunde` → `kunden`\n`persistence/orm.py`\n\n+ kundennummer: int «PK, Identity»\n+ vorname: str\n+ nachname: str\n+ kontonummer: int «FK → bankkonten»\n+ geldkarte: Geldkarte «relationship, 1:1»","x":-1120,"y":3900,"width":560,"height":300,"color":"1"},
		{"id":"1a2b3c4d5e728113","type":"text","text":"#### `orm.Geldkarte` → `geldkarten`\n`persistence/orm.py`\n\n+ kartennummer: int «PK, Identity»\n+ kontonummer: int «FK → bankkonten»\n+ kundennummer: int «FK → kunden»\n+ pin: str\n\n+ check_pin(pin) → bool","x":-480,"y":3900,"width":560,"height":316,"color":"1"},
		{"id":"1a2b3c4d5e72a002","type":"text","text":"#### `orm.Transaktion` → `transaktionen`\n`persistence/orm.py`\n\n+ id: int «PK, Identity»\n+ zeitpunkt: datetime\n+ betrag: Decimal «Numeric(12,2)»\n+ kontonummer: int «FK → bankkonten»","x":160,"y":3900,"width":560,"height":274,"color":"1"},
		{"id":"1a2b3c4d5e72bef1","type":"text","text":"#### `orm.Geldautomat` → `geldautomaten`\n`persistence/orm.py`\n\n+ nummer: int «PK, Identity»\n+ verfuegbares_bargeld: Decimal «Numeric(12,2)»\n+ latitude / longitude: float\n+ location: Location «composite»\n\n+ ermittle_verfuegbares_bargeld() → Decimal\n+ aufladen(betrag)\n+ abheben(betrag)  *wirft `ValueError` bei Unterdeckung*","x":800,"y":3900,"width":560,"height":368,"color":"1"}
	],
